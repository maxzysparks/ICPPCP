# Application Environment
NODE_ENV=development

# API Configuration
PORT=3000
API_PREFIX=/api
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icppcp_dev
DB_USER=icppcp_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TTL=3600

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encryption Keys (AES-256)
ENCRYPTION_KEY=your_32_byte_encryption_key_here
ENCRYPTION_IV=your_16_byte_iv_here

# AWS Configuration (HIPAA-eligible services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=icppcp-documents-dev
AWS_KMS_KEY_ID=your_kms_key_id

# Email Configuration (SendGrid with BAA)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@icppcp.com
EMAIL_FROM_NAME=ICPPCP Platform

# SMS Configuration (Twilio with BAA)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# FHIR Configuration
FHIR_BASE_URL=https://fhir.example.com/r4
FHIR_CLIENT_ID=your_fhir_client_id
FHIR_CLIENT_SECRET=your_fhir_client_secret

# Security Configuration
SESSION_TIMEOUT=1800000
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=2190
AUDIT_LOG_S3_BUCKET=icppcp-audit-logs-dev

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring & Logging
LOG_LEVEL=debug
DATADOG_API_KEY=your_datadog_api_key
SENTRY_DSN=your_sentry_dsn

# PgAdmin (Development Only)
PGADMIN_PASSWORD=admin

# Frontend Configuration (for frontend-web/.env)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=ICPPCP
VITE_APP_VERSION=0.1.0
VITE_ENABLE_ANALYTICS=false

# Feature Flags
FEATURE_EHR_INTEGRATION=false
FEATURE_VIDEO_CALLS=false
FEATURE_AI_SUGGESTIONS=false
FEATURE_INSURANCE_CLAIMS=false
